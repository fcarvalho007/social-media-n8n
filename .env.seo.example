# Apenas servidor local. Copiar para .env.seo.local (ignorado pelo Git).
# Nunca usar prefixo VITE_ para credenciais; nunca as colocar no navegador.
# Acesso API existente: https://app.dataforseo.com/api-access
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DEEPSEEK_API_KEY=
# A interface começa com serviços pagos e automação pausados.
# Verificar ligação é gratuito. Pedidos reais exigem orçamento explícito no Hub.

# Optional server-side JSON array, empty by default. Never expose as VITE_.
# [{"id":"crm","nome":"CRM","projeto":"UUID exacto (ou local no dev)","url":"https://destino.example/webhook","segredo":"gerar fora do navegador, mínimo 32 caracteres"}]
# The interface must additionally activate each destination/event subscription.
HUB_WEBHOOKS_EDITORIAIS=[]
